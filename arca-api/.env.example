# PLANTILLA — este archivo SI se versiona. Nunca pongas secretos reales aca.
# Copialo a .env (que esta en .gitignore) y completa los valores ahi.

PORT=3001

# Origen del front, para CORS.
ORIGEN_PERMITIDO=http://localhost:5173

# Firma de los JWT. Generar uno nuevo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Clave maestra que envuelve las DEK de cada credencial (base64, 32 bytes):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# EN DESARROLLO vive aca. En produccion NO: va en Azure Key Vault, y esta
# variable se reemplaza por la referencia al secreto. Quien tiene este valor
# puede descifrar TODAS las claves fiscales de todos los clientes.
MASTER_KEY=

# 'sqlite'  base local en archivo, persiste entre reinicios (desarrollo).
# 'memoria' datos de demo en RAM, se pierden al reiniciar (tests rapidos).
# 'mssql'   todavia no esta implementado (falta la Azure SQL).
REPOSITORIO=sqlite
SQLITE_PATH=arca.db

# 1 carga usuarios/clientes ficticios solo cuando la base esta vacia.
# Para una base local limpia de uso real, usar 0 desde el primer arranque.
SEMBRAR_DEMO=1
