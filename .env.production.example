# Copiar como .env.production. Este archivo real queda fuera del repositorio.
# Para desarrollo local con HTTP:
SITE_ADDRESS=:80
PUBLIC_ORIGIN=http://localhost

# Para un dominio real, ambos deben apuntar al mismo origen HTTPS:
# SITE_ADDRESS=panel.ejemplo.com
# PUBLIC_ORIGIN=https://panel.ejemplo.com

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Permite descifrar todas las credenciales: respaldarla por separado y no rotarla sin migracion.
MASTER_KEY=

WORKER_POLL_MS=3000
WORKER_JOB_TIMEOUT_MIN=60
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=30
WORKER_ACCOUNT_WAIT_SECONDS=10

# Abrir una comunicacion no leida puede perfeccionar legalmente su notificacion.
DFE_ABRIR_NO_LEIDAS=0

# Si se omiten, usa desde el 1 de enero del año actual hasta hoy.
SYNC_DESDE=
SYNC_HASTA=

