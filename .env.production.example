# Copiar como .env.production. Este archivo real queda fuera del repositorio.
# Para desarrollo local con HTTP:
SITE_ADDRESS=:80
PUBLIC_ORIGIN=http://localhost

# Para un dominio real, ambos deben apuntar al mismo origen HTTPS:
# SITE_ADDRESS=panel.ejemplo.com
# PUBLIC_ORIGIN=https://panel.ejemplo.com

# Cuenta administradora del PRIMER arranque.
#
# Sin esto una instalacion nueva queda sin ningun usuario y no puede entrar
# nadie: crear el primer usuario por HTTP exige ya estar logueado como admin.
#
# Solo actua si la base no tiene NINGUN usuario. Con la base ya poblada no hace
# nada, asi que dejar estas lineas puestas no recrea ni pisa cuentas, y un
# reinicio del servicio es inofensivo.
#
# La contrasena queda en texto plano en este archivo: cambiala desde Mi Cuenta
# apenas entres por primera vez. Y evita el signo $ adentro — este mismo archivo
# lo lee Docker Compose con --env-file, que lo interpreta como una variable.
ADMIN_INICIAL_EMAIL=
ADMIN_INICIAL_PASSWORD=
ADMIN_INICIAL_NOMBRE=Administrador

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Permite descifrar todas las credenciales: respaldarla por separado y no rotarla sin migracion.
MASTER_KEY=

# Sincronizacion automatica nocturna. Apagada por defecto.
# Encola "sincronizacion-completa" de todos los clientes con credencial OK que
# no se hayan intentado en las ultimas SYNC_NOCTURNA_MIN_HORAS.
# La ventana va en hora de America/Buenos_Aires, sin importar el huso del host.
SYNC_NOCTURNA=0
SYNC_NOCTURNA_DESDE=2
SYNC_NOCTURNA_HASTA=5
SYNC_NOCTURNA_MIN_HORAS=12
SYNC_NOCTURNA_INTERVALO_MIN=15

WORKER_POLL_MS=3000
WORKER_JOB_TIMEOUT_MIN=60
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=30
WORKER_ACCOUNT_WAIT_SECONDS=10

# Abrir una comunicacion no leida puede perfeccionar legalmente su notificacion.
DFE_ABRIR_NO_LEIDAS=0

# Si se omiten, usa desde el 1 de enero del año actual hasta hoy.
SYNC_DESDE=
SYNC_HASTA=

