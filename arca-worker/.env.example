# PLANTILLA — este archivo SI se versiona. Nunca pongas credenciales reales aca.
# Copialo a .env (que esta en .gitignore) y completa los valores ahi.
#
# Para el spike de Fase 0 usa TU PROPIA clave fiscal, no la de un cliente.
# Todavia no hay cifrado: en esta fase la clave vive en texto plano en .env.
# El almacenamiento cifrado llega en Fase 1 (envelope encryption + Key Vault).

# CUIT sin guiones, 11 digitos.
ARCA_CUIT=20123456789
ARCA_CLAVE=

# 0 mantiene Chromium oculto; cambia temporalmente a 1 ante CAPTCHA o 2FA.
HEADED=0

# FRESH=1 fuerza login limpio ignorando la sesion guardada en .sessions/
# Hace falta despues de adherir un servicio nuevo: ARCA no refresca la lista
# de servicios hasta que volves a entrar.
FRESH=0

# EMITIDOS o RECIBIDOS.
TIPO=EMITIDOS

# Rango de fechas para el export de Mis Comprobantes (YYYY-MM-DD).
# Si se omiten, el spike usa el mes actual.
# MAXIMO 365 DIAS — es un tope del servicio de ARCA, no nuestro.
DESDE=
HASTA=

# --- Worker local ----------------------------------------------------
# Por default toma SQLite y MASTER_KEY de ../arca-api/.env.
ARCA_API_DIR=../arca-api

# 0 es headless; 1 muestra Chromium para intervenir ante CAPTCHA/2FA.
WORKER_HEADED=0
WORKER_POLL_MS=3000
WORKER_JOB_TIMEOUT_MIN=60

# Leases para ejecutar varios procesos worker sin trabajos huerfanos ni dos
# sesiones simultaneas sobre la misma cuenta ARCA.
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=30
WORKER_ACCOUNT_WAIT_SECONDS=10

# Opt-in sensible. Al consultar el cuerpo de una comunicacion SIN LEER, ARCA
# la considera abierta/notificada. Usa 1 solamente con autorizacion expresa.
DFE_ABRIR_NO_LEIDAS=0

# Si se omiten, sincroniza desde el 1 de enero del anio actual hasta hoy,
# usando la fecha de America/Buenos_Aires.
SYNC_DESDE=
SYNC_HASTA=
