{
  "name": "arca-worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Worker de scraping del portal ARCA (Playwright)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "once": "tsx src/index.ts --once",
    "check:local": "tsx src/index.ts --check",
    "spike": "tsx scripts/spike-login.ts",
    "spike:facilidades": "tsx scripts/spike-facilidades.ts",
    "spike:dfe": "tsx scripts/spike-dfe.ts",
    "spike:saldos": "tsx scripts/spike-saldos.ts",
    "spike:representados": "tsx scripts/spike-representados.ts",
    "probe": "tsx scripts/probe-selectors.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "playwright": "^1.56.1"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
